.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
venv*/
.venv/
.venv*/
ENV/
env/
env*/

# Environments and secrets
.env
!.env.example
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
ssh-certs/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# PyTorch / Deep Learning temporary files & scratch models
*.tmp
*.temp
*.bak
*.swp
*.pt.tmp
*.pth.tmp

# Large temporary datasets or cache
data/cache/
data/downloads/
data/tmp/

# Procedurally-generated synthetic dataset (regenerate via scripts/generate_synthetic_dataset.py)
data/synthetic/**/*.png
data/synthetic/**/*.jpg

# Trained model checkpoints & weights
outputs/checkpoints/*.pt
outputs/checkpoints/*.pth
*.pt
*.pth

# Generated evaluation plots, metrics, and visualization artifacts
outputs/*.png
outputs/*.json
outputs/demo_visuals/*.png
outputs/stress_test/

# Preserve directory structures
!.gitkeep
!data/synthetic/**/.gitkeep
!outputs/**/.gitkeep

# Real-world Kaggle benchmark dataset and provenance (always tracked)
!data/real/
!data/real/**

# Logs and scratch output
*.log
scratch/
tmp/
.cache/
